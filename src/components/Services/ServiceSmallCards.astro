---
import { Icon } from "astro-icon/components";

// IconBuildingWarehouse,
// IconParking,
// IconRoad,
// IconSparkles,
// IconTool,
// IconWalk,

const serviceSections = [
  {
    id: "concrete-driveways",
    icon: "tabler:road",
    label: "Driveways",
  },
  {
    id: "patios-outdoor-spaces",
    icon: "tabler:sun",
    label: "Patios & Outdoor",
  },
  {
    id: "stamped-decorative-concrete",
    icon: "tabler:layers-intersect",
    label: "Stamped & Decorative",
  },
  {
    id: "sidewalks-walkways",
    icon: "tabler:walk",
    label: "Sidewalks",
  },
  {
    id: "commercial-parking-lots",
    icon: "tabler:parking",
    label: "Parking Lots",
  },
  {
    id: "repairs-resurfacing",
    icon: "tabler:tool",
    label: "Repairs",
  },
];
---

<section
  class="border-b border-neutral-200 bg-white backdrop-blur-sm"
  id="service-nav"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-8">
    <div
      class="scrollbar-hide flex gap-1 overflow-x-auto py-3 sm:justify-center sm:gap-2"
    >
      {
        serviceSections.map((section) => (
          <a
            href={`#${section.id}`}
            class="service-nav-link group font-mont text-fore-dark/80 hover:bg-accent/20 hover:text-fore-dark flex shrink-0 items-center gap-2 rounded-sm px-4 py-2.5 text-sm font-semibold transition-all duration-300"
            data-section={section.id}
          >
            <Icon
              name={section.icon}
              class="text-accent group-hover:text-primary size-4 transition-colors"
            />
            <span class="hidden sm:inline">{section.label}</span>
            <span class="sm:hidden">{section.label.split(" ")[0]}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
