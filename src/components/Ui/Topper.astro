---
import cn from "@utils/cn";
import { Icon } from "astro-icon/components";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & {
  iconName: string;
};

const { iconName, class: className, ...rest } = Astro.props;
---

<div class:list={cn("mb-4 flex items-center gap-3", className)} {...rest}>
  <div class="bg-primary flex size-12 items-center justify-center rounded-full">
    <Icon name={iconName} class="text-bodyTextColor size-6" />
  </div>
  <span
    class="font-mont text-primary text-sm font-bold tracking-widest uppercase"
  >
    <slot />
  </span>
</div>
