---
import { Icon } from "astro-icon/components";
import { type HTMLAttributes } from "astro/types";
import cn from "src/utils/cn";

type Props = HTMLAttributes<"a"> & {
  icon?: string;
  withIcon?: boolean;
};

const {
  class: className,
  icon = "tabler:phone-call",
  href: to = "/contact",
  withIcon = true,
  ...props
} = Astro.props;
---

<a
  href={to}
  class:list={cn([
    "group bg-primary hover:bg-primaryLight relative inline-flex h-12.5 items-center overflow-hidden rounded-full border-2 border-gray-900 px-5 py-2.5 text-sm font-semibold text-gray-900 transition",
    className,
  ])}
>
  <span class="relative z-10 inline-flex items-center gap-2">
    <Icon
      name={icon}
      size={20}
      class:list={cn([
        "size-5 transition-transform duration-400 ease-out will-change-transform group-hover:scale-130",
        withIcon ? "" : "hidden",
      ])}
    />
    <slot> Get a Free Quote </slot>
  </span>

  <div
    class="group-hover:animate-gleam pointer-events-none absolute top-0 bottom-0 w-[60%] -skew-x-12 bg-linear-to-r from-transparent via-white/80 to-transparent"
    style="left: -100%;"
  >
  </div>
</a>

