---
// src/components/WhyChooseUs.astro
import CTALink from "@components/CTA/CTALink.astro";
import { Icon } from "astro-icon/components";
import type { HTMLAttributes } from "astro/types";
// import CTALink from "@components/CTALink.astro";

type Props = HTMLAttributes<"section">;

type Highlight = {
  icon: string;
  title: string;
  description: string;
};

const highlights: Highlight[] = [
  {
    icon: "tabler:tools",
    title: "Experienced concrete specialists",
    description: "",
  },
  {
    icon: "tabler:shield-checkered-filled",
    title: "Built for Alberta weather conditions",
    description: "",
  },
  {
    icon: "tabler:diamond",
    title: "High-quality materials & finishes",
    description: "",
  },
  {
    icon: "tabler:heart-handshake",
    title: "Reliable and professional service",
    description: "",
  },
  {
    icon: "tabler:building-community",
    title: "Residential & commercial expertise",
    description: "",
  },
];

const { class: className, ...props } = Astro.props;
---

<section
  class:list={["bg-secondary p-(--sectionPadding) px-4", className]}
  {...props}
>
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-16">
      <!-- Left: Content -->
      <div>
        <span
          class="cs-topper font-mont text-primary mb-2 block text-sm font-bold tracking-widest uppercase"
        >
          Why Choose Us
        </span>
        <h2
          class="text-bodyTextColorWhite cs-title font-mont text-h2 mb-6 font-bold"
        >
          Why Choose Rymor Concrete Co?
        </h2>
        <p
          class="font-mont text-bodyTextColorWhite/90 mb-8 text-lg leading-relaxed"
          data-reveal
          data-direction="left"
          data-distance-x="30"
          data-delay-s="0.15"
          data-once="true"
        >
          Rymor Concretes brings years of hands-on experience in construction,
          coatings, and concrete work. We bring that expertise to every
          project—delivering floors that look stunning and last for years.
        </p>

        <!-- CTA Button -->
        <div
          data-reveal
          data-direction="left"
          data-distance-x="30"
          data-delay-s="0.2"
          data-once="true"
        >
          <!-- <CTALink label="Get Your Free Quote" showIcon={true} variant="primary"/> -->
          <CTALink />
          <!-- <a
            href="/contact"
            class:list={[
              "inline-flex items-center gap-2 px-8 py-4 font-mont font-bold group",
              "border-2 border-amber-300 bg-amber-300 text-neutral-900 transition-all duration-400",
              "hover:rounded-lg hover:bg-transparent hover:text-amber-300",
              "corner-squircle supports-[corner-shape:squircle]:hover:rounded-[50px]",
            ]}
          >
            Get Your Free Quote
            <Icon name="tabler:chevron-right" class="size-5 transition-transform duration-400 group-hover:translate-x-2" />
          </a> -->
        </div>
      </div>

      <!-- Right: Highlights Grid -->
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
        {
          highlights.map((highlight, index) => {
            const shouldCenterLast =
              highlights.length % 2 !== 0 && index === highlights.length - 1;

            return (
              <div
                class:list={[
                  "group bg-primaryLight hover:bg-primary relative overflow-hidden rounded-sm p-6 inset-shadow-white transition-colors duration-[400ms] ease-in",
                  "lg:col-span-2",
                  shouldCenterLast && "md:col-span-2",
                  shouldCenterLast && "lg:col-start-2",
                ]}
              >
                {/* Gleam overlay */}
                <div
                  class="group-hover:animate-gleam pointer-events-none absolute top-0 bottom-0 w-[60%] -skew-x-12 bg-linear-to-r from-transparent via-white/15 to-transparent"
                  style="left: -100%;"
                />

                <div class="relative z-10">
                  <div class="bg-primary group-hover:bg-fore-light/20 mb-4 flex size-12 items-center justify-center rounded-full transition-colors duration-300">
                    <Icon
                      name={highlight.icon}
                      class="group-hover:text-accent size-6 text-white transition-colors duration-[400ms] ease-in"
                    />
                  </div>

                  <h3 class="font-mont text-secondary mb-2 text-lg font-bold">
                    {highlight.title}
                  </h3>

                  <p class="font-mont text-bodyTextColorWhite/90 text-sm leading-relaxed">
                    {highlight.description}
                  </p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
