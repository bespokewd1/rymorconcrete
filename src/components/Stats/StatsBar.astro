---
export type Stats = {
  value: string;
  label: string;
};

interface Props {
  stats: Stats[];
}

const { stats } = Astro.props;
---

<!-- ============================================ --><!--              Stats Bar Section               --><!-- ============================================ -->
<section class="bg-primary hidden py-8 sm:py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-8">
    <div
      class="grid grid-cols-2 gap-6 sm:gap-8 lg:grid-cols-4"
      data-stagger-child-b
      data-distance-y="20"
      data-once="true"
    >
      {
        stats.map((stat) => (
          <div class="text-center">
            <p class="font-mont text-fore-light text-3xl font-extrabold sm:text-4xl lg:text-5xl">
              {stat.value}
            </p>
            <p class="font-mont text-fore-light/80 mt-1 text-sm font-medium sm:text-base">
              {stat.label}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
