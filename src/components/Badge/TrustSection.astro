---
import Topper from "@components/Ui/Topper.astro";
import { Icon } from "astro-icon/components";
---

<section class="py-section-padding bg-white px-4 sm:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="text-center">
      <Topper iconName="tabler:shield-check" class="justify-center">
        Your Peace of Mind
      </Topper>
      <!-- <span
          class="mb-2 block font-mont text-sm font-bold tracking-widest text-accent uppercase"
          data-reveal
          data-direction="bottom"
          data-distance-y="30"
          data-once="true"
        >
          Your Peace of Mind
        </span> -->

      <h2
        class="font-mont text-fore-dark mb-12 text-3xl font-bold sm:text-4xl"
        data-reveal
        data-direction="bottom"
        data-distance-y="30"
        data-delay-s="0.1"
        data-once="true"
      >
        Licensed, Insured & Guaranteed
      </h2>

      <!-- Trust badges -->
      <div
        class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4"
        data-stagger-child-b
        data-distance-y="40"
        data-delay-s="0.15"
        data-once="true"
      >
        {
          [
            {
              icon: "tabler:license",
              title: "Licensed",
              description: "Fully licensed to operate in Alberta",
            },
            {
              icon: "tabler:shield-check",
              title: "Insured",
              description: "Comprehensive liability coverage",
            },
            {
              icon: "tabler:file-certificate",
              title: "Bonded",
              description: "Bonded for your protection",
            },
            {
              icon: "tabler:rosette-discount-check",
              title: "Warranty",
              description: "Workmanship guarantee included",
            },
          ].map((badge) => (
            <div class="border-primary/10 hover:border-primary/30 flex flex-col items-center rounded-sm border p-6 transition-all duration-300 hover:shadow-md">
              <div class="bg-primary/10 mb-4 flex size-16 items-center justify-center rounded-full">
                <Icon name={badge.icon} class="text-primary size-8" />
              </div>
              <h3 class="font-mont text-fore-dark mb-1 text-lg font-bold">
                {badge.title}
              </h3>
              <p class="font-mont text-fore-dark/70 text-sm">
                {badge.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
