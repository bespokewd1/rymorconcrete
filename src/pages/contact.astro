---
// Utils
import { Picture, getImage } from "astro:assets";

// Components
import BaseLayout from "@layouts/BaseLayout.astro";
import Banner from "@components/Banner/Banner.astro";

// Data
import { BUSINESS } from "@data/client";

// Images
import landingImage from "@assets/images/landing.jpg"; // <-- THE PATH TO THE ASSET YOU WANT TO PRELOAD - The asset must live in src
import skyscraperImage from "@assets/images/gallery/skyscraper.jpg";
import { Icon } from "astro-icon/components";
import TextBanner from "@components/Banner/TextBanner.astro";
import CTASection from "@components/CTA/CTASection.astro";
const optimizedImage = await getImage({ src: landingImage, format: "webp" });
---

<BaseLayout
  title="Contact"
  description="Meta description for the page"
  heroImage={optimizedImage}
>
  <section class="relative flex flex-col gap-[clamp(3rem,6vw,4rem)]">
    <TextBanner label="Contact Us" />
    <div
      class="py-section-padding mx-auto flex w-full max-w-[36.25rem] flex-col items-center justify-center gap-[clamp(3rem,6vw,4rem)] lg:max-w-[80rem] lg:flex-row lg:items-stretch lg:justify-between lg:gap-[3.25rem]"
    >
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-1 lg:gap-8">
        {/* Left Column: Contact Details Panel (Styled like your About Card) */}

        {/* Right Column: Contact Form */}
        <div
          class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm md:p-12"
        >
          <h3 class="font-mont mb-6 text-2xl font-bold text-gray-900">
            Request a Quote
          </h3>

          <form class="space-y-6" action="#" method="POST">
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div>
                <label
                  for="name"
                  class="mb-1.5 block text-sm font-semibold text-gray-700"
                  >Name</label
                >
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="John Doe"
                  class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 text-gray-900 transition-all outline-none focus:border-gray-900 focus:bg-white focus:ring-1 focus:ring-gray-900"
                />
              </div>
              <div>
                <label
                  for="phone"
                  class="mb-1.5 block text-sm font-semibold text-gray-700"
                  >Phone</label
                >
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  placeholder="(780) 123-4567"
                  class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 text-gray-900 transition-all outline-none focus:border-gray-900 focus:bg-white focus:ring-1 focus:ring-gray-900"
                />
              </div>
            </div>

            <div>
              <label
                for="email"
                class="mb-1.5 block text-sm font-semibold text-gray-700"
                >Email</label
              >
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="john@example.com"
                class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 text-gray-900 transition-all outline-none focus:border-gray-900 focus:bg-white focus:ring-1 focus:ring-gray-900"
              />
            </div>

            <div>
              <label
                for="details"
                class="mb-1.5 block text-sm font-semibold text-gray-700"
                >Project Details</label
              >
              <textarea
                id="details"
                name="details"
                rows="4"
                required
                placeholder="Tell us about your concrete project..."
                class="w-full resize-none rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 text-gray-900 transition-all outline-none focus:border-gray-900 focus:bg-white focus:ring-1 focus:ring-gray-900"
              ></textarea>
            </div>

            {/* Submit Button styled to exactly match your CTALink component */}
            <button
              type="submit"
              class="group bg-primary hover:bg-primaryLight relative mt-2 inline-flex h-12.5 w-full items-center justify-center overflow-hidden rounded-full border-2 border-gray-900 px-5 py-2.5 text-sm font-semibold text-gray-900 transition"
            >
              <span class="relative z-10 inline-flex items-center gap-2">
                <Icon
                  name="tabler:send"
                  class="size-5 transition-transform duration-400 ease-out will-change-transform group-hover:scale-130"
                  size={20}
                />
                Send Message
              </span>
              <div
                class="group-hover:animate-gleam pointer-events-none absolute top-0 bottom-0 w-[60%] -skew-x-12 bg-linear-to-r from-transparent via-white/80 to-transparent"
                style="left: -100%;"
              >
              </div>
            </button>
          </form>
        </div>

        <div
          class="bg-primary flex h-full flex-col justify-center rounded-2xl p-8 text-gray-900 shadow-lg md:p-12"
        >
          <h2 class="font-mont mb-4 text-3xl font-bold md:text-4xl">
            Get in Touch
          </h2>
          <p class="mb-10 text-lg text-gray-900/80">
            Have a project in mind? We'd love to hear from you. Reach out today
            for a free consultation and let's build something lasting.
          </p>

          <div class="space-y-8">
            {/* Phone */}
            <div class="flex items-center gap-5">
              <div
                class="flex size-12 shrink-0 items-center justify-center rounded-full bg-gray-900/10 transition-colors hover:bg-gray-900/20"
              >
                <Icon name="tabler:phone" class="size-6 text-gray-900" />
              </div>
              <div>
                <p
                  class="text-xs font-bold tracking-wider text-gray-900/70 uppercase"
                >
                  Call Us
                </p>
                <a
                  href="tel:7802632483"
                  class="text-lg font-bold transition-opacity hover:opacity-70"
                  >780-263-2483</a
                >
              </div>
            </div>

            {/* Email */}
            <div class="flex items-center gap-5">
              <div
                class="flex size-12 shrink-0 items-center justify-center rounded-full bg-gray-900/10 transition-colors hover:bg-gray-900/20"
              >
                <Icon name="tabler:mail" class="size-6 text-gray-900" />
              </div>
              <div>
                <p
                  class="text-xs font-bold tracking-wider text-gray-900/70 uppercase"
                >
                  Email Us
                </p>
                <a
                  href="mailto:rymor.concreteco@gmail.com"
                  class="text-lg font-bold break-all transition-opacity hover:opacity-70"
                  >rymor.concreteco@gmail.com</a
                >
              </div>
            </div>

            {/* Location */}
            <div class="flex items-center gap-5">
              <div
                class="flex size-12 shrink-0 items-center justify-center rounded-full bg-gray-900/10 transition-colors hover:bg-gray-900/20"
              >
                <Icon name="tabler:map-pin" class="size-6 text-gray-900" />
              </div>
              <div>
                <p
                  class="text-xs font-bold tracking-wider text-gray-900/70 uppercase"
                >
                  Location
                </p>
                <p class="text-lg font-bold">Edmonton, Alberta</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="relative z-[1] block w-full max-w-[39.375rem]">
        <!-- "border-t-[15px] border-[#224ca1]",
            "rounded-tr-[250px] rounded-bl-[250px] border-r-[15px]", -->
        <div
          class:list={[
            "h-[25rem] w-full overflow-hidden rounded-4xl",
            "lg:aspect-[9/16] lg:h-auto",
          ]}
        >
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d8097.070425737101!2d-114.00173224261772!3d53.52773674923386!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x539f91ce4af32f43%3A0x6af15b473afd6713!2sStony%20Plain%2C%20AB%2C%20Canada!5e1!3m2!1sen!2sph!4v1774888645995!5m2!1sen!2sph"
            width="600"
            height="450"
            style="border:0;"
            class="h-full w-full scale-[1.02]"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
